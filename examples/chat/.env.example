# Use a provider that supports streaming OpenAI-compatible Chat Completions.
# Set the API base URL, not the full /chat/completions endpoint.
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=your-api-key
# One model ID, or comma-separated IDs on the same endpoint (first is default).
MODEL_NAME=your-model-id
PORT=5174
